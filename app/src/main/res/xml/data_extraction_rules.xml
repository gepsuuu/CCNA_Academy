<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up study progress only. The AI tutor settings (API key) and caches are never backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/ccna_progress.preferences_pb" />
        <include domain="file" path="packs/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/ccna_progress.preferences_pb" />
        <include domain="file" path="packs/" />
    </device-transfer>
</data-extraction-rules>
